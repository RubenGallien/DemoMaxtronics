            <Box name="GET_HISTO" id="6" localization="8" tooltip="" x="257" y="223">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4">
                <content>
                  <![CDATA[class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        #put initialization code here
        self.memProxy = ALProxy("ALMemory","localhost",9559)
        pass

    def onUnload(self):
        #put clean-up code here
        pass

    def onInput_onStart(self):
        #self.onStopped() #activate the output of the box

        history = {}
        cheminHisto = os.path.join(
            self.behaviorAbsolutePath(),
            self.getParameter("Histo")
        )

        if os.path.exists(cheminHisto):
            with open(cheminHisto, "r") as f:
                history = json.load(f)

        print(history)
        if history["history"]:
            values = history["history"]
            self.memProxy.insertData("myValueName1", json.dumps(values))
        else:
            self.memProxy.insertData("myValueName1", json.dumps([]))
        print "The value of myValueName1 is", self.memProxy.getData("myValueName1")
        self.onStopped()

        pass

    def onInput_onStop(self):
        self.onUnload() #it is recommended to reuse the clean-up as the box is stopped
        self.onStopped() #activate the output of the box]]>
